# This is an example .env file.
# Copy this file to .env (which is ignored by Git) and fill in your actual values.
# Do NOT commit your .env file containing sensitive credentials.

# Custom AI Service Configuration
CUSTOM_API_URL="YOUR_API_URL_HERE"
CUSTOM_API_KEY="YOUR_API_KEY_HERE"
USE_CUSTOM_API="False" # Set to "True" to enable the custom API service

# Flask Configuration
FLASK_DEBUG="True" # Set to "False" for production
# FLASK_APP="app.py" # Usually not needed if running `python app.py`
# FLASK_ENV="development" # Can be "production"

# Add other configurations as needed
